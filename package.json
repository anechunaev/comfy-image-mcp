{
  "name": "comfy-image-mcp",
  "version": "1.0.0",
  "description": "MCP server that runs your ComfyUI workflows as an image-generation tool for any MCP client.",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "comfyui",
    "image-generation",
    "stable-diffusion",
    "qwen-image"
  ],
  "license": "MIT",
  "author": "Artem Nechunaev",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "comfy-image-mcp": "dist/server.js"
  },
  "files": [
    "dist",
    "workflows",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "start": "node src/server.ts",
    "status": "node src/cli.ts status",
    "gen": "node src/cli.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "node test/e2e.ts",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.1",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  }
}
